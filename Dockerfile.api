# syntax=docker/dockerfile:1

# ---- dependencies -----------------------------------------------------------
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
# --ignore-scripts: a dependency's postinstall must not run arbitrary code in
# the build (docs/architecture/09 §12). Prisma's generate is invoked explicitly.
RUN npm ci --ignore-scripts

# ---- build ------------------------------------------------------------------
FROM deps AS build
WORKDIR /app
COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN npm run build -w @portfolio/shared \
 && npm run build -w @portfolio/api

# ---- production dependencies ------------------------------------------------
FROM node:22-slim AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm ci --omit=dev --ignore-scripts

# ---- runtime ----------------------------------------------------------------
FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build     /app/packages/shared/dist ./packages/shared/dist
COPY --from=build     /app/packages/shared/package.json ./packages/shared/
COPY --from=build     /app/apps/api/dist ./apps/api/dist
COPY --from=build     /app/apps/api/package.json ./apps/api/
COPY                  apps/api/prisma ./apps/api/prisma

# The volume mount points. Owned by the unprivileged user so the app can write
# the SQLite file and uploads without running as root.
RUN mkdir -p /data/uploads && chown -R node:node /data /app
USER node

EXPOSE 4000
# Serves as both a Docker healthcheck and the readiness probe behind the proxy.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/api/v1/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/apps/api
CMD ["node", "dist/server.js"]
