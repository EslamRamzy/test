      "post": {
        "tags": ["Contact"],
        "summary": "Submit the contact form (rate-limited, honeypot, timing check)",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 150
                  },
                  "message": {
