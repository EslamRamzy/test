# Dependencies
node_modules/

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo

# Prisma's generated client (custom output path — regenerated by `prisma generate`,
# which `npm install` triggers via postinstall; see apps/api/package.json)
apps/api/generated/

# Test output
coverage/
.tmp/
playwright-report/
test-results/

# Environment — never commit real values (docs/architecture/09 §9)
.env
.env.*
!.env.example

# Database (SQLite lives on a volume, never in git)
*.db
*.db-journal
*.db-wal
*.db-shm

# Runtime data
uploads/
backups/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Auto-generated by `next dev` (Next.js 16) on every dev-server start —
# AI-agent guidance for whoever runs `next dev` next, not project content.
apps/web/AGENTS.md
apps/web/CLAUDE.md
