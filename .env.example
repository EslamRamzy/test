# =============================================================================
# Docker Compose variable substitution — repo root ONLY
#
# This file is read by `docker compose` (copy it to `.env` at the repo root)
# to fill in the `${VAR}` references in docker-compose.yml. It is NOT read by
# either app when running locally without Docker — Next.js and the Express
# API each load their own `.env` from their own directory:
#
#   apps/api/.env.example   → copy to apps/api/.env    (local API dev)
#   apps/web/.env.example   → copy to apps/web/.env    (local web dev)
#
# This distinction matters and is easy to get wrong: `npm run <script> -w
# @portfolio/api` runs with its CWD set to `apps/api/`, so a `.env` sitting
# at the repo root is silently never read by the running process no matter
# how it's invoked locally. See the README's "Getting started" section.
#
# NEVER commit `.env` or put real values here.
# =============================================================================

# Required for cross-subdomain cookies (D1). Leading dot, apex domain.
COOKIE_DOMAIN=.eslamramzy.dev

# Exact-match, comma-separated. No regex, no suffix matching.
CORS_ORIGIN=https://eslamramzy.dev

# Generate each with: openssl rand -base64 48
CSRF_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

# openssl rand -base64 32
IP_HASH_SALT=
REVALIDATE_SECRET=

# Inlined into the web image's browser bundle at BUILD time (a Docker build
# arg — see docker-compose.yml and Dockerfile.web), not read at runtime.
NEXT_PUBLIC_API_URL=https://api.eslamramzy.dev

PUBLIC_SITE_URL=https://eslamramzy.dev
