{
  "name": "@portfolio/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for domain constants, Zod schemas and API types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
