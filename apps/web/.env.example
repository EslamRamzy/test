# =============================================================================
# @portfolio/web — local environment template
#
# Copy to `apps/web/.env` and fill in. Next.js loads `.env` automatically
# from its own app directory — never from the repo root or from apps/api/.
# NEVER commit `.env` or put real values here.
#
# `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time,
# not read at runtime (see the README and docs/architecture/09 §9) — nothing
# sensitive may ever use that prefix.
# =============================================================================

# Public API origin the browser talks to (decision D1 — a separate origin
# from the site itself). Server Components instead call the internal
# container address directly; see docs/architecture/04 §7 (arrives Phase 4-6).
NEXT_PUBLIC_API_URL=https://api.local.eslamramzy.dev

# Public site origin. Used for canonical URLs, sitemap and OG tags (Phase 6+).
PUBLIC_SITE_URL=https://local.eslamramzy.dev
