# =============================================================================
# @portfolio/api — local environment template
#
# Copy to `apps/api/.env` and fill in. NEVER commit `.env` or put real values
# here. `src/config/env.ts` validates these at boot and exits on failure.
#
# WHY THIS FILE LIVES HERE AND NOT AT THE REPO ROOT: `npm run <script> -w
# @portfolio/api` runs with its CWD set to `apps/api/` (verified — this is
# standard npm workspace behaviour), and `env.ts` loads `.env` from
# `process.cwd()` with no path argument. A `.env` at the repo root is never
# read by the running process, no matter how it's invoked locally — only
# `apps/api/.env` is. The repo-root `.env.example` still exists, but it feeds
# `docker-compose.yml`'s variable substitution for the containerised
# deployment (decision D3), which is a separate mechanism from this file.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Origins (decision D1 — two origins on the SAME registrable domain)
#
# The API MUST stay a subdomain of the site's apex domain. A different
# registrable domain would be genuinely cross-site and force SameSite=None.
#
# Local dev mirrors production. Add to /etc/hosts:
#   127.0.0.1  local.eslamramzy.dev  api.local.eslamramzy.dev
# -----------------------------------------------------------------------------
PORT=4000

# Public site origin. Used for canonical URLs, sitemap and OG tags (Phase 6+).
PUBLIC_SITE_URL=https://local.eslamramzy.dev

# CORS allow-list: exact match, comma-separated.
# No regex. No suffix matching — `endsWith('.eslamramzy.dev')` also matches
# `evil-eslamramzy.dev`. See docs/architecture/09 §3.
CORS_ORIGIN=https://local.eslamramzy.dev

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="file:./prisma/portfolio.db"

# -----------------------------------------------------------------------------
# Auth — generate each with: openssl rand -base64 48
# Minimum 32 characters. The API refuses to boot in production with a
# placeholder or a short value. Not yet read by env.ts — arrives in Phase 4.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Required for cross-subdomain cookies (D1). Leading dot, apex domain.
# Note: this is why cookies use the __Secure- prefix and not __Host-.
COOKIE_DOMAIN=.local.eslamramzy.dev

# -----------------------------------------------------------------------------
# Bootstrap admin — used once by `npm run db:bootstrap -w @portfolio/api`,
# then change the password. There is no public registration and no public
# password reset (brief §25).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
# Optional — defaults to "Admin", editable later from the admin UI.
ADMIN_NAME=

# -----------------------------------------------------------------------------
# Privacy — salt for hashing visitor IPs. Raw IPs are never stored.
# openssl rand -base64 32. Not yet read by env.ts — arrives in Phase 10/13.
# -----------------------------------------------------------------------------
IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# -----------------------------------------------------------------------------
# On-demand revalidation: API -> Next.js when content is published
# openssl rand -base64 32. Not yet read by env.ts — arrives in Phase 6/8.
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Optional SMTP for contact-form notifications.
# Leave blank to disable. The contact form never fails because mail is down.
# Not yet read by env.ts — arrives in Phase 10.
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Feature toggles — not yet read by env.ts.
# -----------------------------------------------------------------------------
ENABLE_API_DOCS=false
ENABLE_ANALYTICS=true
